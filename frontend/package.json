    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "7.18.4",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "vaul": "1.1.2",
    "zod": "4.6.7"
