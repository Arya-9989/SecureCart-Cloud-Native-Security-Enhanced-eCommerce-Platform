# Copy to .env and fill in the secrets:  cp .env.example .env
# Used by docker compose and (for the DJANGO_* / DATABASE_URL values) by local development.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Required ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-too

# --- Optional (defaults shown) ------------------------------------------------------------
# POSTGRES_DB=securecart
# POSTGRES_USER=securecart
# JWT_SIGNING_KEY=            # defaults to DJANGO_SECRET_KEY; set separately to rotate independently
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# HTTP_PORT=8080

# Browsers treat http://localhost as a secure context, so Secure cookies work locally.
# Only set false if you serve the app over plain HTTP on a non-localhost hostname.
# REFRESH_COOKIE_SECURE=true

# Seed the demo catalog, accounts and order history on startup (idempotent).
# SEED_DEMO=true
# DEMO_ADMIN_PASSWORD=SecureCart!Admin1
# DEMO_CUSTOMER_PASSWORD=SecureCart!Demo1
# VITE_DEMO_MODE=true          # show demo-account shortcuts on the sign-in page

# Email. Compose sends to its bundled Mailpit (inbox at http://localhost:8025). For a real
# relay set EMAIL_HOST/EMAIL_PORT (587 = STARTTLS, 465 = TLS) and the credentials.
# APP_BASE_URL=http://localhost:8080    # origin used in emailed links
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=false
# DEFAULT_FROM_EMAIL=SecureCart <no-reply@securecart.dev>
# REQUIRE_VERIFIED_EMAIL=true          # checkout needs a confirmed address
# MAILPIT_UI_PORT=8025

# Payment provider class (dotted path). The default mock provider moves no money.
# PAYMENT_PROVIDER=apps.payments.providers.mock.MockPaymentProvider
#
# Stripe in TEST mode (your own test keys; nothing here is ever needed by CI):
#   1. Dashboard (test mode) > Developers > API keys: copy the secret key (sk_test_...).
#   2. `stripe listen --forward-to localhost:8080/api/payments/webhooks/stripe/` prints the
#      webhook signing secret (whsec_...). Keep it running while you test.
#   3. Uncomment, then `docker compose up -d --build backend`.
# PAYMENT_PROVIDER=apps.payments.providers.stripe_provider.StripePaymentProvider
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Live keys (sk_live_) are refused unless this is set; leave it off for this demo store.
# STRIPE_ALLOW_LIVE_MODE=false

# --- Local development without Docker (backend/) -------------------------------------------
# DJANGO_DEBUG=true
# DATABASE_URL=sqlite:///db.sqlite3
# REFRESH_COOKIE_SECURE=false
